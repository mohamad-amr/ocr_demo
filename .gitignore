# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Dart compiler dependency metadata (worker JavaScript is checked in).
/assets/workers/*.deps

# Local review artifacts, screenshots, and document exports.
/output/
/tmp/

